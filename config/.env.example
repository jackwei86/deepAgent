# DeepAgent configuration template — copy to config/.env and fill in real values
# DeepSeek LLM (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PATH=/v1/chat/completions

# DeepAgent server
DEEPAGENT_HOST=127.0.0.1
DEEPAGENT_PORT=8090
DEEPAGENT_CTX_RETENTION_DAYS=15
# DEEPAGENT_UDRT_DIR / DEEPAGENT_CHATS_FILE / DEEPAGENT_FRONTEND_DIR / DEEPAGENT_KNOWLEDGE_DIR 可选覆盖
