            },
            "props_st": {},
            "sinker_index": 0
        },
        "saturn_gaus_render": {
            "model_name": "0x70000001",
            "model_comment": "Gaussian Render",
            "kind": "saturn",
            "description": "本地 PLY 高斯渲染节点（Graph_Saturn 真实节点）",
            "input_ports": {},
            "output_ports": { "render_out": 0 },
            "props": {
                "fCamDistanceScale": 0.10000000149011612,
